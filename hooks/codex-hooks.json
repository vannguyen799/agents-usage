{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/scripts/report-codex-usage.sh",
            "timeout": 10,
            "statusMessage": "reporting usage"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/scripts/report-codex-usage.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
